{
  "manifest_version": 3,
  "name": "YT Premium Vibe",
  "short_name": "YT Vibe",
  "version": "1.0.0",
  "description": "Make YouTube feel premium: sponsor skip, ad blocking, smart quality, AI summaries, downloads and more.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YT Premium Vibe",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://sponsor.ajay.app/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "page/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "shared/settings.js",
        "content/lib.js",
        "content/bridge-client.js",
        "content/features/ad-blocker.js",
        "content/features/sponsor-skip.js",
        "content/features/hide-shorts.js",
        "content/features/custom-speed.js",
        "content/features/smart-quality.js",
        "content/features/pip.js",
        "content/features/cinema-mode.js",
        "content/features/volume-boost.js",
        "content/features/download.js",
        "content/features/ai-summary.js",
        "content/features/audio-track.js",
        "content/main.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules/ad-rules.json"
      }
    ]
  }
}
